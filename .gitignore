# input data, third-party code and caches: never commit
# (only the placeholder READMEs in data/ and external/README.md are tracked)
/data/**
!/data/**/
!/data/**/README.md
/external/**
!/external/README.md
/.env/
*.npy
*.npz
*.parquet
*.h5
*.feather
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
scratch/
results/m7/scratch_*/

# environments, local build outputs, assistant settings
.venv/
.claude/
manuscript/~$*
*.pkl
